generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Linha {
  id    Int    @id @default(autoincrement())
  nome  String
  rotas Rota[]
}

model Rota {
  id      Int     @id @default(autoincrement())
  nome    String
  linhaId Int
  linha   Linha   @relation(fields: [linhaId], references: [id])
  pontos  Ponto[]
}

model Ponto {
  id        Int    @id @default(autoincrement())
  nome      String
  latitude  Float
  longitude Float
  rotaId    Int
  rota      Rota   @relation(fields: [rotaId], references: [id])
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  cpf      String   @unique @db.Char(11)
  email    String   @unique
  telefone String   @db.Char(11)
  senha    String   @db.Char(60)
  cartoes  Cartao[]
}

enum TipoPasse {
  NORMAL
  ESTUDANTE
}

model Cartao {
  id                    Int       @id @default(autoincrement())
  nome                  String
  numeroTccc            String    @unique
  saldo                 Float     @default(0)
  perfilId              Int?
  perfil                Usuario?  @relation(fields: [perfilId], references: [id])
  tipoPasse             TipoPasse @default(NORMAL)
  instituicaoEnsino     String?
  comprovanteResidencia String?
}